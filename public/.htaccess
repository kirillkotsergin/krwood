# ==========================================================================
# krwood.ee — Apache configuration for the static Astro build
# Deployed to /home/r319522/public_html on Radicenter (cPanel, Apache + PHP 8.3)
# ==========================================================================

# Serve index.html for directory requests (Astro's `directory` build format).
DirectoryIndex index.html index.php

# Never expose a directory listing.
Options -Indexes

# --------------------------------------------------------------------------
# Override the host's AI-crawler user-agent block
# --------------------------------------------------------------------------
# Radicenter applies a server-level authorisation rule that returns 403 to a
# curated list of AI crawlers — case-insensitive substring matches on gptbot,
# claudebot, ccbot, meta-externalagent and bytespider — on every path,
# including /robots.txt and the sitemap. That last part is the damaging bit: a
# crawler that cannot read robots.txt generally treats the whole site as
# disallowed, so those agents never crawl at all.
#
# It is not ModSecurity. Disabling ModSecurity in cPanel left the 403s
# completely unchanged, and a ModSecurity block could not be overridden by an
# authorisation directive. This one can be, which is what identifies it: a
# directory-level `Require` replaces the inherited server-level one.
#
# Verified in an isolated subdirectory before being applied here.
#
# The two `Require all denied` blocks at the foot of this file are in
# <FilesMatch> context, which is more specific than this directory-level
# grant, so dotfiles and source maps stay protected. Both are re-tested after
# every deploy — do not remove this comment without re-checking them.
<RequireAny>
  Require all granted
</RequireAny>

# --------------------------------------------------------------------------
# Canonical host + HTTPS
# --------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Let Let's Encrypt / cPanel AutoSSL validate without interference.
  RewriteRule ^\.well-known/ - [L]

  # ---- Canonical origin: https://krwood.ee, reached in ONE hop -----------
  # The host is named literally rather than reflected from %{HTTP_HOST}.
  # Reflecting it made http://www.krwood.ee/x a three-hop chain (https-www ->
  # non-www -> trailing slash) and let a forged Host header turn this into an
  # open redirect. Every hop is a chance for Googlebot to time out, which is
  # what a GSC "Redirect error" is usually reporting.

  # Not secure -> canonical origin, dropping any www. in the same hop.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://krwood.ee%{REQUEST_URI} [R=301,L]

  # Already secure but on www. -> canonical origin.
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://krwood.ee%{REQUEST_URI} [R=301,L]

  # --- Legacy slug redirects ---------------------------------------------
  # The lignin pages briefly used the English slug in every language. Both
  # rules are anchored, so /en/lignin-pellets/ (still the live English URL)
  # is not caught by either. Targets are absolute so the hop can never be
  # rebuilt as http:// from ServerName.
  RewriteRule ^lignin-pellets/?$    https://krwood.ee/ligniin-pelletid/ [R=301,L]
  RewriteRule ^pl/lignin-pellets/?$ https://krwood.ee/pl/pellet-ligninowy/ [R=301,L]

  # Collapse the directory-index duplicate onto the canonical URL.
  RewriteRule ^index\.html$      https://krwood.ee/ [R=301,L]
  RewriteRule ^(.+)/index\.html$ https://krwood.ee/$1/ [R=301,L]

  # Crawlers and audit tools probe /sitemap.xml; ours is a sitemap index.
  RewriteRule ^sitemap\.xml$ https://krwood.ee/sitemap-index.xml [R=301,L]

  # ---- Trailing slash ----------------------------------------------------
  # Astro's `directory` build format makes every page a directory, so the
  # canonical URL always ends in /. Left alone, that 301 is generated by
  # mod_dir's DirectorySlash, which rebuilds the URL from the server's own
  # idea of the scheme and port -- a wrong guess sends Googlebot to http://
  # and straight back through the HTTPS rule above, an intermittent loop that
  # only ever shows up in Search Console. Issuing the redirect here makes the
  # target absolute, https, and always exactly one hop.
  #
  # Must run last: the slug rules above match their slashless form, so this
  # would otherwise add a second hop in front of each of them.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.+[^/])$ https://krwood.ee/$1/ [R=301,L]
</IfModule>

# --------------------------------------------------------------------------
# Custom error page
# --------------------------------------------------------------------------
ErrorDocument 404 /404.html

# --------------------------------------------------------------------------
# Compression
# --------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/woff2 font/woff application/font-woff
</IfModule>

# --------------------------------------------------------------------------
# Caching
#   Astro fingerprints hashed assets under /_astro/, so those are immutable.
#   HTML must always be revalidated so deployments show up immediately.
# --------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 0 seconds"
  ExpiresByType text/xml "access plus 0 seconds"

  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Astro fingerprints everything under /_astro/, so those names change on
  # every content change and may be cached forever.
  #
  # This MUST stay scoped to that directory. Matching on file extension
  # instead also catches the hand-placed files in public/, whose names never
  # change — `immutable` then tells browsers never to revalidate them, and a
  # replaced image stays invisible to anyone who loaded the old one until the
  # cache expires a year later. Prefer importing an image from src/assets/
  # (see src/components/LigninPellets.astro) over adding one to public/.
  # SetEnvIf rather than <If>, which needs Apache 2.4 — a syntax the server
  # rejects takes the whole site down with a 500, and mod_setenvif is
  # available everywhere.
  SetEnvIf Request_URI "^/_astro/" FINGERPRINTED_ASSET
  Header set Cache-Control "public, max-age=31536000, immutable" env=FINGERPRINTED_ASSET

  # Stable-URL assets in public/: cached, but revalidated so a replacement
  # goes live within the day. Apache's ETag and Last-Modified make the
  # revalidation a cheap 304 in the normal case.
  <FilesMatch "\.(css|js|woff2?|svg|avif|webp|png|jpe?g|ico)$">
    Header set Cache-Control "public, max-age=86400, stale-while-revalidate=604800" env=!FINGERPRINTED_ASSET
  </FilesMatch>

  # HTML and the sitemap must revalidate on every request.
  <FilesMatch "\.(html|xml)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # ---- Security headers -------------------------------------------------
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"

  # ---- Content Security Policy ------------------------------------------
  # Tight by default: everything is served from this origin. The only
  # exception is Cloudflare Web Analytics, which needs two hosts named
  # explicitly, because `default-src 'self'` would otherwise block it
  # SILENTLY — no console error, no data, no clue why.
  #
  #   script-src   static.cloudflareinsights.com   serves beacon.min.js
  #   connect-src  cloudflareinsights.com          receives POST /cdn-cgi/rum
  #
  # `connect-src` must be listed in full once it is declared: it stops
  # inheriting from default-src, so dropping 'self' here would break the
  # footer visit counter's fetch to /counter.php. Both hosts also appear in
  # ANALYTICS_CSP_HOSTS in src/config/analytics.ts — keep them in step.
  #
  # Adding a different analytics vendor means widening BOTH directives; its
  # script host alone is not enough, because the beacon endpoint is usually
  # on another hostname.
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com; font-src 'self'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"

  # Do not leak the PHP version.
  Header unset X-Powered-By

  # ---- Dynamic endpoints must never be cached ---------------------------
  # contact.php and counter.php both send `Cache-Control: no-store`
  # themselves, but mod_expires has no override for a PHP response and so
  # ExpiresDefault adds a second, 30-day Cache-Control alongside it. Two
  # conflicting values are ambiguous — a proxy that honours the wrong one
  # would freeze the visit counts and could replay a form response. `set`
  # replaces every existing instance, leaving exactly one correct header.
  <FilesMatch "\.php$">
    Header always set Cache-Control "no-store, max-age=0"
    Header always unset Expires
    Header always unset Pragma

    # Both endpoints return JSON, not indexable pages. noindex rather than a
    # robots.txt Disallow: a disallowed URL can still be indexed from an
    # inbound link, and Google would never be allowed to fetch the header
    # telling it not to. See the note in robots.txt.
    Header always set X-Robots-Tag "noindex"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  # Belt and braces: stop mod_expires generating the header in the first
  # place, so the directive above has nothing to clean up.
  <FilesMatch "\.php$">
    ExpiresActive Off
  </FilesMatch>
</IfModule>

# --------------------------------------------------------------------------
# Correct MIME types
# --------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/svg+xml .svg
  AddType image/avif .avif
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
  # llms.txt, robots.txt and the IndexNow key are UTF-8 (≥, –, €); without a
  # charset some clients guess Latin-1 and garble them.
  AddCharset UTF-8 .txt
</IfModule>

# --------------------------------------------------------------------------
# Block access to dotfiles and source maps
# --------------------------------------------------------------------------
<FilesMatch "^\.(?!well-known)">
  Require all denied
</FilesMatch>

<FilesMatch "\.map$">
  Require all denied
</FilesMatch>
