# ==========================================================================
# krwood.ee — Apache configuration for the static Astro build
# Deployed to /home/r319522/public_html on Radicenter (cPanel, Apache + PHP 8.3)
# ==========================================================================

# Serve index.html for directory requests (Astro's `directory` build format).
DirectoryIndex index.html index.php

# Never expose a directory listing.
Options -Indexes

# --------------------------------------------------------------------------
# Canonical host + HTTPS
# --------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Let Let's Encrypt / cPanel AutoSSL validate without interference.
  RewriteRule ^\.well-known/ - [L]

  # Force HTTPS.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Drop the www. prefix so krwood.ee is the single canonical host.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # --- Legacy slug redirects ---------------------------------------------
  # The lignin pages briefly used the English slug in every language. Both
  # rules are anchored, so /en/lignin-pellets/ (still the live English URL)
  # is not caught by either.
  RewriteRule ^lignin-pellets/?$ /ligniin-pelletid/ [R=301,L]
  RewriteRule ^pl/lignin-pellets/?$ /pl/pellet-ligninowy/ [R=301,L]

  # Collapse the directory-index duplicate onto the canonical URL.
  RewriteRule ^index\.html$ / [R=301,L]
  RewriteRule ^(.+)/index\.html$ /$1/ [R=301,L]

  # Crawlers and audit tools probe /sitemap.xml; ours is a sitemap index.
  RewriteRule ^sitemap\.xml$ /sitemap-index.xml [R=301,L]
</IfModule>

# --------------------------------------------------------------------------
# Custom error page
# --------------------------------------------------------------------------
ErrorDocument 404 /404.html

# --------------------------------------------------------------------------
# Compression
# --------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/woff2 font/woff application/font-woff
</IfModule>

# --------------------------------------------------------------------------
# Caching
#   Astro fingerprints hashed assets under /_astro/, so those are immutable.
#   HTML must always be revalidated so deployments show up immediately.
# --------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 0 seconds"
  ExpiresByType text/xml "access plus 0 seconds"

  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Hashed build assets never change under the same name.
  <FilesMatch "\.(css|js|woff2?|svg|avif|webp|png|jpe?g)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML and the sitemap must revalidate on every request.
  <FilesMatch "\.(html|xml)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # ---- Security headers -------------------------------------------------
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"

  # The site loads no third-party resources, so the policy can stay tight.
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"

  # Do not leak the PHP version.
  Header unset X-Powered-By
</IfModule>

# --------------------------------------------------------------------------
# Correct MIME types
# --------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/svg+xml .svg
  AddType image/avif .avif
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
</IfModule>

# --------------------------------------------------------------------------
# Block access to dotfiles and source maps
# --------------------------------------------------------------------------
<FilesMatch "^\.(?!well-known)">
  Require all denied
</FilesMatch>

<FilesMatch "\.map$">
  Require all denied
</FilesMatch>
