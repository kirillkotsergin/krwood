# Normalise line endings. The build and deploy run on Linux, and CRLF in
# .htaccess or contact.php can break Apache/PHP parsing, so everything text
# is stored and checked out as LF.
* text=auto eol=lf

# Binary assets must never be line-ending converted.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.avif  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
