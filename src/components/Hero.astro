---
import { getLangFromUrl, useTranslations, anchorLink } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const stats = [
  { value: t('hero.stat1Value'), unit: t('hero.stat1Unit'), label: t('hero.stat1Label') },
  { value: t('hero.stat2Value'), unit: t('hero.stat2Unit'), label: t('hero.stat2Label') },
  { value: t('hero.stat3Value'), unit: t('hero.stat3Unit'), label: t('hero.stat3Label') },
];
---

<section
  id="hero"
  class="relative -mt-16 flex min-h-[clamp(38rem,92svh,52rem)] items-center overflow-hidden pt-16 lg:-mt-20 lg:pt-20"
>
  <!--
    Background image.
    To use a real photograph, drop a wide JPG at `public/images/hero.jpg`
    and change the url() below to '/images/hero.jpg'. Everything else
    (overlay, contrast, text colours) keeps working unchanged.
  -->
  <div
    class="absolute inset-0 -z-20 bg-forest-950 bg-cover bg-center bg-no-repeat"
    style="background-image:url('/images/hero-forest.svg')"
    aria-hidden="true"
  >
  </div>

  <!-- Dark gradient overlay for text readability -->
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-br from-forest-950/95 via-forest-950/75 to-forest-900/55"
    aria-hidden="true"
  >
  </div>
  <!-- Bottom fade into the page background -->
  <div
    class="absolute inset-x-0 bottom-0 -z-10 h-40 bg-gradient-to-b from-transparent to-stone-50"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto w-full max-w-7xl px-5 py-20 sm:px-8 lg:py-28">
    <div class="max-w-3xl">
      <!-- Certification badge -->
      <p
        data-animate
        class="inline-flex items-center gap-2 rounded-full bg-white/10 py-1.5 pl-1.5 pr-4 text-sm font-semibold text-wood-100 ring-1 ring-inset ring-white/20 backdrop-blur-sm"
      >
        <span class="grid size-6 place-items-center rounded-full bg-wood-500/90 text-white">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="size-3.5"
            aria-hidden="true"
          >
            <path d="M20 6 9 17l-5-5"></path>
          </svg>
        </span>
        {t('hero.badge')}
      </p>

      <!-- Headline -->
      <h1
        data-animate
        style="--animate-delay:80ms"
        class="mt-6 text-4xl font-extrabold leading-[1.05] tracking-tight text-white sm:text-6xl lg:text-7xl"
      >
        {t('hero.title')}
        <span class="mt-1 block text-gradient-wood">{t('hero.titleAccent')}</span>
      </h1>

      <!-- Subtitle -->
      <p
        data-animate
        style="--animate-delay:160ms"
        class="mt-7 max-w-2xl text-lg leading-relaxed text-stone-200/90 sm:text-xl"
      >
        {t('hero.subtitle')}
      </p>

      <!-- CTAs -->
      <div data-animate style="--animate-delay:240ms" class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a
          href={anchorLink('contact', lang)}
          class="group inline-flex items-center justify-center gap-2 rounded-full bg-wood-600 px-8 py-4 text-base font-bold text-white shadow-xl shadow-wood-950/30 transition-all duration-300 hover:-translate-y-1 hover:scale-[1.03] hover:bg-wood-500 hover:shadow-2xl hover:shadow-wood-900/40 active:translate-y-0 active:scale-100"
        >
          {t('hero.ctaPrimary')}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="size-5 transition-transform duration-300 group-hover:translate-x-1"
            aria-hidden="true"
          >
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </a>

        <a
          href={anchorLink('specs', lang)}
          class="inline-flex items-center justify-center gap-2 rounded-full bg-white/10 px-8 py-4 text-base font-bold text-white ring-1 ring-inset ring-white/30 backdrop-blur-sm transition-all duration-300 hover:-translate-y-1 hover:bg-white/20 hover:ring-white/50 active:translate-y-0"
        >
          {t('hero.ctaSecondary')}
        </a>
      </div>

      <!-- Key figures -->
      <dl
        data-animate
        style="--animate-delay:320ms"
        class="mt-14 grid max-w-2xl grid-cols-3 gap-4 border-t border-white/15 pt-8 sm:gap-8"
      >
        {
          stats.map((stat) => (
            <div class="flex flex-col">
              <dt class="order-2 mt-1 text-xs font-medium uppercase tracking-wider text-stone-300/70 sm:text-sm sm:tracking-wide">
                {stat.label}
              </dt>
              <dd class="order-1 text-2xl font-extrabold text-white sm:text-4xl">
                {stat.value}
                <span class="ml-0.5 text-sm font-bold text-wood-300 sm:text-base">{stat.unit}</span>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>

  <!-- Scroll cue -->
  <div
    class="pointer-events-none absolute bottom-6 left-1/2 hidden -translate-x-1/2 lg:block"
    aria-hidden="true"
  >
    <span class="flex h-11 w-7 items-start justify-center rounded-full ring-2 ring-white/30 p-1.5">
      <span class="size-1.5 animate-bounce rounded-full bg-white/70"></span>
    </span>
  </div>
</section>
