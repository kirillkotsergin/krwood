---
/**
 * Cloudflare Web Analytics beacon.
 *
 * Emits nothing at all until a token is set in `src/config/analytics.ts`, so
 * the site ships no third-party request by default.
 *
 * `is:inline` keeps Astro from bundling and rewriting the tag — the beacon has
 * to stay an external script with its `data-cf-beacon` attribute intact.
 *
 * `type="module"` and the placement at the end of <body> are both what
 * Cloudflare's own snippet specifies. Module scripts are deferred by default,
 * so this stays off the critical path without needing `defer`.
 */
import { analytics, analyticsEnabled } from '../config/analytics';

// JSON.stringify rather than string interpolation: the attribute value is
// JSON, and a token containing a quote would otherwise break out of it.
const beacon = JSON.stringify({ token: analytics.cloudflareToken });
---

{
  analyticsEnabled && (
    <script
      is:inline
      type="module"
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon={beacon}
    />
  )
}
