---
import { getLangFromUrl, useTranslations, anchorLink, localizePath } from '../i18n/utils';
import Logo from './Logo.astro';
import LanguagePicker from './LanguagePicker.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Anchor items point at sections of the landing page; the lignin entry is a
// real sub-page, so its href is a localized path rather than an anchor.
const navItems = [
  { href: anchorLink('features', lang), label: t('nav.features') },
  { href: anchorLink('specs', lang), label: t('nav.specs') },
  { href: anchorLink('packaging', lang), label: t('nav.packaging') },
  { href: localizePath('/lignin-pellets', lang), label: t('nav.lignin') },
  { href: anchorLink('contact', lang), label: t('nav.contact') },
];

const homeHref = localizePath('/', lang);
const contactHref = anchorLink('contact', lang);
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent bg-stone-50/70 backdrop-blur-lg transition-[background-color,border-color,box-shadow] duration-300 data-[scrolled]:border-stone-200/80 data-[scrolled]:bg-stone-50/90 data-[scrolled]:shadow-sm"
>
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-5 sm:px-8 lg:h-20">
    <!-- Logo -->
    <a
      href={homeHref}
      aria-label={t('a11y.homepage')}
      class="shrink-0 rounded-lg transition-transform duration-200 hover:scale-[1.03]"
    >
      <Logo />
    </a>

    <!-- Desktop navigation -->
    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class="group relative block rounded-lg px-3.5 py-2 text-sm font-semibold text-stone-600 transition-colors duration-200 hover:text-forest-800"
              >
                {item.label}
                <span class="absolute inset-x-3.5 -bottom-0.5 h-0.5 origin-left scale-x-0 rounded-full bg-wood-500 transition-transform duration-300 group-hover:scale-x-100" />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Desktop actions -->
    <div class="hidden items-center gap-3 lg:flex">
      <LanguagePicker />
      <a
        href={contactHref}
        class="group inline-flex items-center gap-2 rounded-full bg-forest-800 px-5 py-2.5 text-sm font-semibold text-white shadow-md shadow-forest-900/20 transition-all duration-300 hover:-translate-y-0.5 hover:scale-[1.03] hover:bg-forest-700 hover:shadow-lg hover:shadow-forest-900/30 active:translate-y-0"
      >
        {t('nav.cta')}
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-4 transition-transform duration-300 group-hover:translate-x-0.5"
          aria-hidden="true"
        >
          <path d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      </a>
    </div>

    <!-- Mobile actions -->
    <div class="flex items-center gap-2 lg:hidden">
      <LanguagePicker />
      <button
        type="button"
        id="menu-toggle"
        aria-controls="mobile-menu"
        aria-expanded="false"
        class="group grid size-10 place-items-center rounded-xl text-stone-700 ring-1 ring-stone-300/70 transition-colors duration-200 hover:bg-stone-200/70 hover:text-forest-800"
      >
        <span class="sr-only" data-label-open={t('a11y.openMenu')} data-label-close={t('a11y.closeMenu')}>
          {t('a11y.openMenu')}
        </span>
        <!-- Hamburger / close icon (animated) -->
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          class="size-6"
          aria-hidden="true"
        >
          <line
            x1="4"
            y1="7"
            x2="20"
            y2="7"
            class="origin-center transition-transform duration-300 group-aria-expanded:translate-y-[5px] group-aria-expanded:rotate-45"
          ></line>
          <line
            x1="4"
            y1="12"
            x2="20"
            y2="12"
            class="origin-center transition-opacity duration-200 group-aria-expanded:opacity-0"
          ></line>
          <line
            x1="4"
            y1="17"
            x2="20"
            y2="17"
            class="origin-center transition-transform duration-300 group-aria-expanded:-translate-y-[5px] group-aria-expanded:-rotate-45"
          ></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu panel -->
  <div
    id="mobile-menu"
    hidden
    class="border-t border-stone-200/80 bg-stone-50/98 backdrop-blur-xl lg:hidden"
  >
    <nav aria-label="Mobile" class="mx-auto max-w-7xl px-5 pb-7 pt-4 sm:px-8">
      <ul class="flex flex-col gap-1">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                data-menu-link
                class="flex items-center justify-between rounded-xl px-4 py-3.5 text-base font-semibold text-stone-700 transition-colors duration-200 hover:bg-white hover:text-forest-800"
              >
                {item.label}
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="size-4 text-stone-400"
                  aria-hidden="true"
                >
                  <path d="m9 18 6-6-6-6" />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>

      <a
        href={contactHref}
        data-menu-link
        class="mt-5 flex items-center justify-center gap-2 rounded-full bg-forest-800 px-6 py-3.5 text-base font-semibold text-white shadow-md shadow-forest-900/20 transition-all duration-300 hover:bg-forest-700 active:scale-[0.98]"
      >
        {t('nav.cta')}
      </a>
    </nav>
  </div>
</header>

<!-- Spacer so page content is not hidden behind the fixed header -->
<div class="h-16 lg:h-20" aria-hidden="true"></div>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  // ---- Sticky header shadow on scroll ---------------------------------
  if (header) {
    const syncHeaderState = () => {
      if (window.scrollY > 8) {
        header.setAttribute('data-scrolled', '');
      } else {
        header.removeAttribute('data-scrolled');
      }
    };

    syncHeaderState();
    window.addEventListener('scroll', syncHeaderState, { passive: true });
  }

  // ---- Mobile menu disclosure -----------------------------------------
  if (toggle && menu) {
    const srLabel = toggle.querySelector<HTMLElement>('[data-label-open]');
    const labelOpen = srLabel?.dataset.labelOpen ?? 'Open menu';
    const labelClose = srLabel?.dataset.labelClose ?? 'Close menu';

    const setMenu = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
      document.body.classList.toggle('scroll-locked', open);
      if (srLabel) srLabel.textContent = open ? labelClose : labelOpen;
    };

    toggle.addEventListener('click', () => {
      setMenu(toggle.getAttribute('aria-expanded') !== 'true');
    });

    // Close when a link inside the menu is followed.
    menu.querySelectorAll('[data-menu-link]').forEach((link) => {
      link.addEventListener('click', () => setMenu(false));
    });

    // Close on Escape and return focus to the toggle.
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setMenu(false);
        toggle.focus();
      }
    });

    // Reset when resizing up to the desktop breakpoint.
    const desktop = window.matchMedia('(min-width: 1024px)');
    desktop.addEventListener('change', (event) => {
      if (event.matches) setMenu(false);
    });
  }
</script>
