---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

type IconName = 'flame' | 'sparkle' | 'leaf' | 'certificate';

interface Feature {
  icon: IconName;
  title: string;
  text: string;
}

const features: Feature[] = [
  { icon: 'flame', title: t('features.heat.title'), text: t('features.heat.text') },
  { icon: 'sparkle', title: t('features.ash.title'), text: t('features.ash.text') },
  { icon: 'leaf', title: t('features.eco.title'), text: t('features.eco.text') },
  { icon: 'certificate', title: t('features.quality.title'), text: t('features.quality.text') },
];
---

<section id="features" class="relative scroll-mt-20 overflow-hidden bg-stone-50 py-24 lg:py-32">
  <!-- Soft decorative glow — 48rem wide, so the section must clip it on phones -->
  <div
    class="pointer-events-none absolute left-1/2 top-0 -z-0 h-72 w-[48rem] -translate-x-1/2 rounded-full bg-wood-200/25 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-7xl px-5 sm:px-8">
    <!-- Section heading -->
    <div class="mx-auto max-w-3xl text-center">
      <p
        data-animate
        class="inline-flex items-center gap-2 rounded-full bg-forest-100 px-4 py-1.5 text-sm font-bold uppercase tracking-wider text-forest-700"
      >
        <span class="size-1.5 rounded-full bg-forest-500"></span>
        {t('features.eyebrow')}
      </p>
      <h2 data-animate style="--animate-delay:60ms" class="mt-5 text-3xl sm:text-4xl lg:text-5xl">
        {t('features.title')}
      </h2>
      <p data-animate style="--animate-delay:120ms" class="mt-5 text-lg leading-relaxed text-stone-600">
        {t('features.subtitle')}
      </p>
    </div>

    <!-- Icon grid -->
    <ul class="mt-16 grid gap-6 sm:grid-cols-2 lg:mt-20 lg:grid-cols-4">
      {
        features.map((feature) => (
          <li
            data-animate
            data-animate-stagger
            class="group relative flex flex-col rounded-2xl border border-stone-200/80 bg-white p-7 shadow-sm transition-all duration-300 hover:-translate-y-1.5 hover:border-wood-200 hover:shadow-xl hover:shadow-stone-900/[0.07]"
          >
            {/* Icon */}
            <span class="grid size-14 place-items-center rounded-2xl bg-gradient-to-br from-forest-50 to-forest-100 text-forest-700 ring-1 ring-inset ring-forest-200/70 transition-all duration-300 group-hover:from-wood-50 group-hover:to-wood-100 group-hover:text-wood-700 group-hover:ring-wood-200">
              {feature.icon === 'flame' && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="size-7"
                  aria-hidden="true"
                >
                  <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5Z" />
                </svg>
              )}
              {feature.icon === 'sparkle' && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="size-7"
                  aria-hidden="true"
                >
                  <path d="M9.94 6.06 12 1.5l2.06 4.56L18.5 8l-4.44 1.94L12 14.5l-2.06-4.56L5.5 8l4.44-1.94Z" />
                  <path d="m18.7 15.3.8 1.9 1.9.8-1.9.8-.8 1.9-.8-1.9-1.9-.8 1.9-.8.8-1.9Z" />
                  <path d="m5.3 14.3.7 1.7 1.7.7-1.7.7-.7 1.7-.7-1.7-1.7-.7 1.7-.7.7-1.7Z" />
                </svg>
              )}
              {feature.icon === 'leaf' && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="size-7"
                  aria-hidden="true"
                >
                  <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z" />
                  <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12" />
                </svg>
              )}
              {feature.icon === 'certificate' && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="size-7"
                  aria-hidden="true"
                >
                  <circle cx="12" cy="9" r="6" />
                  <path d="M12 6.5 13.1 8.6l2.4.3-1.75 1.65.43 2.35L12 11.75 9.82 12.9l.43-2.35L8.5 8.9l2.4-.3L12 6.5Z" />
                  <path d="m8.2 14.6-1.7 6.4 5.5-2.6 5.5 2.6-1.7-6.4" />
                </svg>
              )}
            </span>

            <h3 class="mt-6 text-xl">{feature.title}</h3>
            <p class="mt-3 text-[0.9375rem] leading-relaxed text-stone-600">{feature.text}</p>

            {/* Bottom accent line on hover */}
            <span
              class="absolute inset-x-7 bottom-0 h-0.5 origin-left scale-x-0 rounded-full bg-gradient-to-r from-wood-500 to-wood-300 transition-transform duration-500 group-hover:scale-x-100"
              aria-hidden="true"
            />
          </li>
        ))
      }
    </ul>
  </div>
</section>
