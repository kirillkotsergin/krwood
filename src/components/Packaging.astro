---
import { getLangFromUrl, useTranslations, anchorLink } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

type PackIcon = 'bags' | 'bigbag' | 'truck';

interface Pack {
  icon: PackIcon;
  title: string;
  desc: string;
  specs: string[];
}

const packs: Pack[] = [
  {
    icon: 'bags',
    title: t('packaging.bags.title'),
    desc: t('packaging.bags.desc'),
    specs: [t('packaging.bags.spec1'), t('packaging.bags.spec2'), t('packaging.bags.spec3')],
  },
  {
    icon: 'bigbag',
    title: t('packaging.bigbag.title'),
    desc: t('packaging.bigbag.desc'),
    specs: [t('packaging.bigbag.spec1'), t('packaging.bigbag.spec2'), t('packaging.bigbag.spec3')],
  },
  {
    icon: 'truck',
    title: t('packaging.delivery.title'),
    desc: t('packaging.delivery.desc'),
    specs: [
      t('packaging.delivery.spec1'),
      t('packaging.delivery.spec2'),
      t('packaging.delivery.spec3'),
    ],
  },
];
---

<section id="packaging" class="relative scroll-mt-20 bg-stone-100/70 py-24 lg:py-32">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <p
        data-animate
        class="inline-flex items-center gap-2 rounded-full bg-forest-100 px-4 py-1.5 text-sm font-bold uppercase tracking-wider text-forest-700"
      >
        <span class="size-1.5 rounded-full bg-forest-500"></span>
        {t('packaging.eyebrow')}
      </p>
      <h2 data-animate style="--animate-delay:60ms" class="mt-5 text-3xl sm:text-4xl lg:text-5xl">
        {t('packaging.title')}
      </h2>
      <p data-animate style="--animate-delay:120ms" class="mt-5 text-lg leading-relaxed text-stone-600">
        {t('packaging.subtitle')}
      </p>
    </div>

    <ul class="mt-16 grid gap-6 md:grid-cols-3 lg:mt-20">
      {
        packs.map((pack) => (
          <li
            data-animate
            data-animate-stagger
            class="group flex flex-col rounded-3xl border border-stone-200 bg-white p-8 shadow-sm transition-all duration-300 hover:-translate-y-1.5 hover:border-forest-200 hover:shadow-xl hover:shadow-stone-900/[0.07]"
          >
            <span class="grid size-16 place-items-center rounded-2xl bg-gradient-to-br from-forest-700 to-forest-900 text-white shadow-lg shadow-forest-900/25 transition-transform duration-300 group-hover:scale-105 group-hover:-rotate-3">
              {pack.icon === 'bags' && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="size-8"
                  aria-hidden="true"
                >
                  <path d="M7 3.5h10l-1 4H8l-1-4Z" />
                  <path d="M8 7.5h8l1.6 9.2a2 2 0 0 1-2 2.3H8.4a2 2 0 0 1-2-2.3L8 7.5Z" />
                  <path d="M3 21.5h18" />
                  <path d="M10.5 11.5h3" />
                </svg>
              )}
              {pack.icon === 'bigbag' && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="size-8"
                  aria-hidden="true"
                >
                  <path d="M7.5 2.5v2.2a2.2 2.2 0 0 0 4.4 0V2.5" opacity="0.85" />
                  <path d="M12.1 2.5v2.2a2.2 2.2 0 0 0 4.4 0V2.5" opacity="0.85" />
                  <path d="M5 6.5h14v11a3 3 0 0 1-3 3H8a3 3 0 0 1-3-3v-11Z" />
                  <path d="M10 20.5v1.2h4v-1.2" />
                  <path d="M5 10.5h14" opacity="0.6" />
                </svg>
              )}
              {pack.icon === 'truck' && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="size-8"
                  aria-hidden="true"
                >
                  <path d="M2 6.5h11v10H2v-10Z" />
                  <path d="M13 9.5h4.2l3.3 3.4v3.6H13v-7Z" />
                  <circle cx="6.5" cy="18.5" r="2" />
                  <circle cx="17" cy="18.5" r="2" />
                  <path d="M8.5 18.5H15" />
                </svg>
              )}
            </span>

            <h3 class="mt-7 text-xl">{pack.title}</h3>
            <p class="mt-3 text-[0.9375rem] leading-relaxed text-stone-600">{pack.desc}</p>

            <ul class="mt-6 flex flex-col gap-2.5 border-t border-stone-100 pt-6">
              {pack.specs.map((spec) => (
                <li class="flex items-center gap-3 text-sm font-medium text-stone-700">
                  <span class="grid size-5 shrink-0 place-items-center rounded-full bg-forest-100 text-forest-700">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="3.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="size-3"
                      aria-hidden="true"
                    >
                      <path d="M20 6 9 17l-5-5" />
                    </svg>
                  </span>
                  {spec}
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>

    <!-- Section CTA -->
    <div data-animate class="mt-14 text-center">
      <a
        href={anchorLink('contact', lang)}
        class="group inline-flex items-center justify-center gap-2 rounded-full bg-forest-800 px-8 py-4 text-base font-bold text-white shadow-lg shadow-forest-900/25 transition-all duration-300 hover:-translate-y-1 hover:scale-[1.03] hover:bg-forest-700 hover:shadow-xl active:translate-y-0 active:scale-100"
      >
        {t('packaging.cta')}
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-5 transition-transform duration-300 group-hover:translate-x-1"
          aria-hidden="true"
        >
          <path d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      </a>
    </div>
  </div>
</section>
