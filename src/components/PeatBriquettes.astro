---
/**
 * Peat briquettes product landing page.
 *
 * All copy comes from `src/i18n/ui.ts` under the `peat.*` keys, so every
 * language version of this page stays in sync and a missing translation
 * fails `npm run check`. The figures (calorific value, moisture, the gas
 * equivalent) are dictionary values too, filled into the running text with
 * `fillPlaceholders`, so the hero, the spec table and the FAQ cannot disagree.
 *
 * The price comes from src/config/pricing.ts (`peatBriquettes`), like every
 * other product's: <PriceTag> shows it, the Product node's Offer carries it
 * and the FAQ answer quotes it, so the three cannot disagree.
 */
import {
  getLangFromUrl,
  useTranslations,
  anchorLink,
  localizePath,
  fillPlaceholders,
} from '../i18n/utils';
import { siteConfig, whatsappUrl } from '../config/site';
import { peatAsh, formatAshValue, ashValue } from '../config/peatAsh';
import { pricing, formatPrice, vatSentence, PRODUCT_IDS } from '../config/pricing';
import {
  ORGANIZATION_ID,
  buildAdditionalProperties,
  buildOffer,
  buildReviewNodes,
} from '../config/schema';
import { peatSpecRows, type SpecRow } from '../config/specs';
import Faq from './Faq.astro';
import PriceTag from './PriceTag.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const origin = Astro.site ?? new URL(Astro.url.origin);
const pageUrl = new URL(Astro.url.pathname, origin).href;

const contactHref = anchorLink('contact', lang);
// Empty when no WhatsApp number is configured — the buttons then disappear.
const whatsappHref = whatsappUrl(t('peat.whatsappMessage'));

/* ------------------------------------------------------------------ */
/* Content                                                            */
/* ------------------------------------------------------------------ */

const figures = {
  calorific: t('peat.value.calorific'),
  moisture: t('peat.value.moisture'),
  gas: t('peat.value.gas'),
  equiv: t('peat.value.equiv'),
  burn: t('peat.value.burn'),
  // 84 packs per pallet, 1000 kg — the owner's figures (02.11.2026).
  packaging: t('peat.value.packaging'),
  // From the manufacturer's ash analysis — see src/config/peatAsh.ts.
  calcium: ashValue('peat.ash.row.calcium', lang),
  ph: ashValue('peat.ash.row.ph', lang),
  // Wood briquettes, for the "peat or wood briquettes" answer — the same
  // Estonian reference table as the peat figure.
  woodCalorific: t('peat.value.woodCalorific'),
  // The FAQ's price answer — the same figures <PriceTag> shows.
  price: formatPrice(pricing.peatBriquettes.amount, lang),
  perTon: t('price.perTon'),
  vatNote: vatSentence(t),
};
const fill = (text: string) => fillPlaceholders(text, figures);

// Moisture is left to the spec table: the pallet is what a buyer plans by.
const heroFacts = [
  { label: t('specs.row.calorific'), value: figures.calorific },
  { label: t('peat.fact.pallet'), value: t('peat.value.palletWeight') },
  { label: t('peat.row.burn'), value: figures.burn },
];

const aboutSections = [
  { title: t('peat.about.made.title'), text: t('peat.about.made.text') },
  { title: t('peat.about.burn.title'), text: t('peat.about.burn.text') },
];

const benefits = [
  { title: t('peat.benefits.b1.title'), text: t('peat.benefits.b1.text') },
  { title: t('peat.benefits.b2.title'), text: t('peat.benefits.b2.text') },
  { title: t('peat.benefits.b3.title'), text: t('peat.benefits.b3.text') },
  { title: t('peat.benefits.b4.title'), text: t('peat.benefits.b4.text') },
  { title: t('peat.benefits.b5.title'), text: fill(t('peat.benefits.b5.text')) },
];

const uses = [
  {
    icon: 'home' as const,
    title: t('peat.uses.home.title'),
    lead: t('peat.uses.home.lead'),
    items: [t('peat.uses.home.i1'), t('peat.uses.home.i2'), t('peat.uses.home.i3')],
  },
  {
    icon: 'industry' as const,
    title: t('peat.uses.industry.title'),
    lead: t('peat.uses.industry.lead'),
    items: [
      t('peat.uses.industry.i1'),
      t('peat.uses.industry.i2'),
      t('peat.uses.industry.i3'),
      t('peat.uses.industry.i4'),
      t('peat.uses.industry.i5'),
      t('peat.uses.industry.i6'),
      t('peat.uses.industry.i7'),
    ],
  },
];

// The same rows as the Product node's additionalProperty, plus availability.
// The price is left to <PriceTag> in the hero: a second "Price" row here
// would be a second price for `check:pricing` to account for.
const specRows: (SpecRow & { highlight?: boolean; inStock?: boolean })[] = [
  ...peatSpecRows(t).map((row) => ({ ...row, highlight: row.value === figures.calorific })),
  { label: t('peat.row.availability'), value: t('peat.stock'), inStock: true },
];

const ashSteps = [
  { title: t('peat.ash.s1.title'), text: t('peat.ash.s1.text') },
  { title: t('peat.ash.s2.title'), text: t('peat.ash.s2.text') },
  { title: t('peat.ash.s3.title'), text: t('peat.ash.s3.text') },
  { title: t('peat.ash.s4.title'), text: t('peat.ash.s4.text') },
];

const ashRows = peatAsh.map((row) => ({
  label: t(row.label),
  value: formatAshValue(row, lang),
  highlight: row.highlight === true,
}));

const faq = [
  { question: t('peat.faq.q1'), answer: fill(t('peat.faq.a1')) },
  { question: t('peat.faq.q2'), answer: fill(t('peat.faq.a2')) },
  { question: t('peat.faq.q3'), answer: fill(t('peat.faq.a3')) },
  { question: t('peat.faq.q4'), answer: fill(t('peat.faq.a4')) },
  { question: t('peat.faq.q5'), answer: fill(t('peat.faq.a5')) },
  // Packing sits next to the price question — the two are asked together.
  { question: t('peat.faq.q8'), answer: fill(t('peat.faq.a8')) },
  { question: t('peat.faq.q6'), answer: fill(t('peat.faq.a6')) },
  { question: t('peat.faq.q7'), answer: fill(t('peat.faq.a7')) },
];

/* ------------------------------------------------------------------ */
/* Structured data                                                    */
/* ------------------------------------------------------------------ */

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  // The same stable id the business's offer catalogue uses, so this page and
  // the catalogue describe one product rather than two.
  '@id': PRODUCT_IDS.peatBriquettes,
  name: t('peat.hero.title'),
  description: t('peat.meta.description'),
  url: pageUrl,
  category: 'Solid fuel / Peat briquettes',
  material: t('peat.value.material'),
  brand: { '@id': ORGANIZATION_ID },
  additionalProperty: buildAdditionalProperties(peatSpecRows(t)),
  // Price, currency, VAT and InStock — see buildOffer in src/config/schema.ts.
  offers: buildOffer('peatBriquettes', pageUrl),
  // Emits nothing while there are no real reviews; see src/config/reviews.ts.
  ...buildReviewNodes('peatBriquettes'),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  // Referenced by the page's WebPage node (Layout.astro) as its `breadcrumb`.
  '@id': `${pageUrl}#breadcrumb`,
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: siteConfig.name,
      item: new URL(localizePath('/', lang), origin).href,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: t('peat.hero.title'),
      item: pageUrl,
    },
  ],
};
---

<article>
  <!-- ==================== Hero ==================== -->
  <section class="relative overflow-hidden bg-forest-950 py-20 lg:py-28">
    <div
      class="pointer-events-none absolute -right-32 -top-32 size-[34rem] rounded-full bg-wood-600/15 blur-3xl"
      aria-hidden="true"
    >
    </div>

    <div class="relative mx-auto grid max-w-7xl gap-12 px-5 sm:px-8 lg:grid-cols-2 lg:items-center lg:gap-16">
      <div>
        <nav aria-label="Breadcrumb" class="mb-6">
          <ol class="flex items-center gap-2 text-sm text-stone-400">
            <li>
              <a href={localizePath('/', lang)} class="transition-colors hover:text-wood-300">
                {siteConfig.name}
              </a>
            </li>
            <li aria-hidden="true" class="text-stone-600">/</li>
            <li class="font-semibold text-wood-300" aria-current="page">{t('peat.hero.title')}</li>
          </ol>
        </nav>

        <!-- Availability: text first, the dot only reinforces it -->
        <p
          data-animate
          class="inline-flex items-center gap-2.5 rounded-full bg-forest-500/15 px-4 py-1.5 text-sm font-bold uppercase tracking-wider text-forest-200 ring-1 ring-inset ring-forest-400/40"
        >
          <span class="relative flex size-2.5" aria-hidden="true">
            <span class="absolute inline-flex size-full animate-ping rounded-full bg-forest-400 opacity-75 motion-reduce:animate-none"></span>
            <span class="relative inline-flex size-2.5 rounded-full bg-forest-400"></span>
          </span>
          {t('peat.stock')}
        </p>

        <h1
          data-animate
          style="--animate-delay:80ms"
          class="mt-6 text-4xl font-extrabold leading-[1.08] tracking-tight text-white sm:text-5xl lg:text-6xl"
        >
          {t('peat.hero.title')}
          <span class="mt-2 block text-2xl text-gradient-wood sm:text-3xl lg:text-4xl">
            {t('peat.hero.titleAccent')}
          </span>
        </h1>

        <p data-animate style="--animate-delay:160ms" class="mt-7 text-lg leading-relaxed text-stone-300">
          {t('peat.hero.lead')}
        </p>

        <!-- bg-white under the tag's translucent gradient: on this dark hero it
             would otherwise blend with the forest green. -->
        <PriceTag
          product="peatBriquettes"
          class="mt-8 bg-white sm:max-w-sm"
          data-animate
          style="--animate-delay:200ms"
        />

        <div data-animate style="--animate-delay:240ms" class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a
            href={contactHref}
            class="group inline-flex items-center justify-center gap-2 rounded-full bg-wood-600 px-8 py-4 text-base font-bold text-white shadow-xl shadow-wood-950/30 transition-all duration-300 hover:-translate-y-1 hover:scale-[1.03] hover:bg-wood-500 active:translate-y-0"
          >
            {t('peat.hero.ctaPrimary')}
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="size-5 transition-transform duration-300 group-hover:translate-x-1"
              aria-hidden="true"
            >
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          </a>
          {
            whatsappHref !== '' && (
              <a
                href={whatsappHref}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2.5 rounded-full bg-white/10 px-8 py-4 text-base font-bold text-white ring-1 ring-inset ring-white/30 transition-all duration-300 hover:-translate-y-1 hover:bg-white/20 active:translate-y-0"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  class="size-5 text-whatsapp"
                  aria-hidden="true"
                >
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z" />
                </svg>
                {t('peat.hero.ctaWhatsapp')}
              </a>
            )
          }
        </div>

        <dl data-animate style="--animate-delay:320ms" class="mt-12 grid grid-cols-3 gap-4 border-t border-white/15 pt-8">
          {
            heroFacts.map((fact) => (
              <div class="flex flex-col">
                <dt class="order-2 mt-1 text-xs font-medium uppercase tracking-wider text-stone-400">
                  {fact.label}
                </dt>
                <dd class="order-1 text-xl font-extrabold text-white sm:text-2xl">{fact.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <!-- Energy equivalent: 1 t of briquettes against natural gas -->
      <figure
        data-animate
        style="--animate-delay:200ms"
        class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-forest-800 to-forest-900 p-8 shadow-2xl shadow-black/40 ring-1 ring-white/10 sm:p-10"
      >
        <span
          class="pointer-events-none absolute -bottom-24 -left-24 size-64 rounded-full bg-wood-500/15 blur-3xl"
          aria-hidden="true"></span>

        <p class="relative text-sm font-bold uppercase tracking-wider text-wood-200">{t('peat.equiv.eyebrow')}</p>

        <div class="relative mt-6 flex items-center gap-5">
          <span class="grid size-16 shrink-0 place-items-center rounded-2xl bg-wood-600/20 text-wood-200 ring-1 ring-inset ring-wood-400/30">
            <!-- Stacked briquettes -->
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 48 48"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linejoin="round"
              class="size-10"
              aria-hidden="true"
            >
              <rect x="4" y="27" width="19" height="11" rx="3"></rect>
              <rect x="25" y="27" width="19" height="11" rx="3"></rect>
              <rect x="14" y="14" width="20" height="11" rx="3"></rect>
              <path d="M9 32.5h9M30 32.5h9M19 19.5h10" stroke-width="1.6" stroke-linecap="round" opacity="0.6"></path>
            </svg>
          </span>
          <p class="text-2xl font-extrabold leading-tight text-white sm:text-3xl">{t('peat.equiv.from')}</p>
        </div>

        <p class="relative my-5 pl-5 text-4xl font-extrabold leading-none text-wood-400" aria-hidden="true">≈</p>

        <div class="relative flex items-center gap-5">
          <span class="grid size-16 shrink-0 place-items-center rounded-2xl bg-white/10 text-stone-200 ring-1 ring-inset ring-white/20">
            <!-- Gas flame -->
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="size-9"
              aria-hidden="true"
            >
              <path d="M15.362 5.214A8.252 8.252 0 0 1 12 21 8.25 8.25 0 0 1 6.038 7.047 8.287 8.287 0 0 0 9 9.601a8.983 8.983 0 0 1 3.361-6.867 8.21 8.21 0 0 0 3 2.48Z"></path>
              <path d="M12 18a3.75 3.75 0 0 0 .495-7.468 5.99 5.99 0 0 0-1.925 3.547 5.975 5.975 0 0 1-2.133-1.001A3.75 3.75 0 0 0 12 18Z"></path>
            </svg>
          </span>
          <p class="flex flex-col">
            <span class="whitespace-nowrap text-3xl font-extrabold leading-none text-gradient-wood sm:text-5xl">{figures.equiv}</span>
            <span class="mt-2 text-lg text-stone-300">{t('peat.equiv.to')}</span>
          </p>
        </div>

        <figcaption class="relative mt-8 border-t border-white/15 pt-5 text-sm leading-relaxed text-stone-400">
          {fill(t('peat.equiv.note'))}
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- ==================== What it is and how it burns ==================== -->
  <section id="peat-about" class="scroll-mt-20 bg-stone-50 py-24 lg:py-32">
    <div class="mx-auto max-w-3xl px-5 sm:px-8">
      <p
        data-animate
        class="inline-flex items-center gap-2 rounded-full bg-forest-100 px-4 py-1.5 text-sm font-bold uppercase tracking-wider text-forest-700"
      >
        <span class="size-1.5 rounded-full bg-forest-500"></span>
        {t('peat.about.eyebrow')}
      </p>
      <h2 data-animate style="--animate-delay:60ms" class="mt-5 text-3xl sm:text-4xl lg:text-5xl">
        {t('peat.about.title')}
      </h2>

      <!-- The short answer first: the sentence search and AI engines quote. -->
      <p data-animate style="--animate-delay:120ms" class="mt-6 text-xl leading-relaxed text-stone-700">
        {t('peat.about.lead')}
      </p>

      {
        aboutSections.map((section) => (
          <div data-animate class="mt-12">
            <h3 class="text-2xl">{section.title}</h3>
            <p class="mt-4 text-lg leading-relaxed text-stone-600">{section.text}</p>
          </div>
        ))
      }

      <!-- Practical firing advice, given its own visual weight -->
      <aside data-animate class="mt-12 rounded-2xl border-l-4 border-wood-500 bg-wood-50/70 p-6 sm:p-8">
        <h3 class="text-xl">{t('peat.about.use.title')}</h3>
        <p class="mt-3 text-[1.0625rem] leading-relaxed text-stone-700">{t('peat.about.use.text')}</p>
      </aside>
    </div>
  </section>

  <!-- ==================== Advantages ==================== -->
  <section id="peat-benefits" class="scroll-mt-20 bg-white py-24 lg:py-32">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <h2 data-animate class="mx-auto max-w-3xl text-center text-3xl sm:text-4xl lg:text-5xl">
        {t('peat.benefits.title')}
      </h2>

      <!-- Five cards: the last row is centred rather than left hanging. -->
      <ul class="mt-14 flex flex-wrap justify-center gap-6">
        {
          benefits.map((benefit) => (
            <li
              data-animate
              data-animate-stagger
              class="w-full rounded-2xl border border-stone-200 bg-stone-50 p-7 shadow-sm transition-all duration-300 hover:-translate-y-1.5 hover:border-wood-200 hover:bg-white hover:shadow-xl sm:w-[calc(50%-0.75rem)] lg:w-[calc(33.333%-1rem)]"
            >
              <span class="block h-1 w-10 rounded-full bg-wood-500" aria-hidden="true"></span>
              <h3 class="mt-5 text-lg font-bold text-stone-900">{benefit.title}</h3>
              <p class="mt-3 text-[0.9375rem] leading-relaxed text-stone-600">{benefit.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ==================== Where to use ==================== -->
  <section id="peat-uses" class="scroll-mt-20 bg-stone-100/70 py-24 lg:py-32">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <p
          data-animate
          class="inline-flex items-center gap-2 rounded-full bg-wood-100 px-4 py-1.5 text-sm font-bold uppercase tracking-wider text-wood-700"
        >
          <span class="size-1.5 rounded-full bg-wood-500"></span>
          {t('peat.uses.eyebrow')}
        </p>
        <h2 data-animate style="--animate-delay:60ms" class="mt-5 text-3xl sm:text-4xl lg:text-5xl">
          {t('peat.uses.title')}
        </h2>
        <p data-animate style="--animate-delay:120ms" class="mt-5 text-lg leading-relaxed text-stone-600">
          {t('peat.uses.subtitle')}
        </p>
      </div>

      <div class="mx-auto mt-16 grid max-w-5xl gap-6 md:grid-cols-2">
        {
          uses.map((use) => (
            <div
              data-animate
              data-animate-stagger
              class="flex flex-col rounded-3xl border border-stone-200 bg-white p-8 shadow-sm transition-all duration-300 hover:-translate-y-1.5 hover:border-forest-200 hover:shadow-xl"
            >
              <span class="grid size-14 place-items-center rounded-2xl bg-gradient-to-br from-forest-700 to-forest-900 text-white shadow-lg shadow-forest-900/25">
                {use.icon === 'home' && (
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="size-7" aria-hidden="true">
                    <path d="M3 10.5 12 3l9 7.5" />
                    <path d="M5 9v11a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1V9" />
                  </svg>
                )}
                {use.icon === 'industry' && (
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="size-7" aria-hidden="true">
                    <path d="M3 21V11l5 3v-3l5 3v-3l5 3V5h3v16Z" />
                    <path d="M7 17.5h2M12 17.5h2" />
                  </svg>
                )}
              </span>

              <h3 class="mt-6 text-2xl">{use.title}</h3>
              <p class="mt-3 text-[0.9375rem] leading-relaxed text-stone-600">{use.lead}</p>

              <ul class={`mt-5 grid gap-2.5 ${use.items.length > 4 ? 'sm:grid-cols-2' : ''}`}>
                {use.items.map((item) => (
                  <li class="flex items-start gap-3 text-[0.9375rem] leading-relaxed text-stone-700">
                    <span class="mt-2 size-1.5 shrink-0 rounded-full bg-forest-500" aria-hidden="true" />
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ==================== Specifications ==================== -->
  <section id="peat-specs" class="scroll-mt-20 bg-white py-24 lg:py-32">
    <div class="mx-auto max-w-3xl px-5 sm:px-8">
      <h2 data-animate class="text-3xl sm:text-4xl lg:text-5xl">{t('peat.specs.title')}</h2>
      <p data-animate style="--animate-delay:60ms" class="mt-5 text-lg leading-relaxed text-stone-600">
        {t('peat.specs.subtitle')}
      </p>

      <div
        data-animate
        style="--animate-delay:120ms"
        class="mt-10 overflow-hidden rounded-3xl border border-stone-200 shadow-sm"
      >
        <table class="w-full border-collapse text-left">
          <caption class="sr-only">{t('peat.specs.title')}</caption>
          <thead class="bg-stone-100">
            <tr>
              <th scope="col" class="px-6 py-3 text-xs font-bold uppercase tracking-wider text-stone-500">
                {t('specs.table.param')}
              </th>
              <th scope="col" class="px-6 py-3 text-right text-xs font-bold uppercase tracking-wider text-stone-500">
                {t('specs.table.value')}
              </th>
            </tr>
          </thead>
          <tbody>
            {
              specRows.map((row) => (
                <tr class="border-t border-stone-100">
                  <th scope="row" class="px-6 py-4 font-medium text-stone-600">
                    {row.label}
                  </th>
                  <td
                    class={`px-6 py-4 text-right font-bold ${
                      row.highlight ? 'text-lg text-wood-700' : row.inStock ? 'text-forest-700' : 'text-stone-900'
                    }`}
                  >
                    {row.inStock ? (
                      <span class="inline-flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true">
                          <path d="M20 6 9 17l-5-5" />
                        </svg>
                        {row.value}
                      </span>
                    ) : (
                      row.value
                    )}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p data-animate class="mt-5 text-sm leading-relaxed text-stone-500">{t('peat.specs.note')}</p>
    </div>
  </section>

  <!-- ==================== What to do with the ash ==================== -->
  <section id="peat-ash" class="scroll-mt-20 bg-stone-100/70 py-24 lg:py-32">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <p
          data-animate
          class="inline-flex items-center gap-2 rounded-full bg-forest-100 px-4 py-1.5 text-sm font-bold uppercase tracking-wider text-forest-700"
        >
          <span class="size-1.5 rounded-full bg-forest-500"></span>
          {t('peat.ash.eyebrow')}
        </p>
        <h2 data-animate style="--animate-delay:60ms" class="mt-5 text-3xl sm:text-4xl lg:text-5xl">
          {t('peat.ash.title')}
        </h2>
        <p data-animate style="--animate-delay:120ms" class="mt-5 text-lg leading-relaxed text-stone-600">
          {t('peat.ash.lead')}
        </p>
      </div>

      <!-- From the firebox to the garden; the list order is the order of use. -->
      <ol class="mx-auto mt-14 grid max-w-5xl gap-6 sm:grid-cols-2">
        {
          ashSteps.map((step, index) => (
            <li
              data-animate
              data-animate-stagger
              class="flex flex-col rounded-3xl border border-stone-200 bg-white p-7 shadow-sm transition-all duration-300 hover:-translate-y-1.5 hover:border-wood-200 hover:shadow-xl"
            >
              <span
                class="grid size-10 place-items-center rounded-full bg-wood-600 text-base font-extrabold text-white shadow-md shadow-wood-900/20"
                aria-hidden="true"
              >
                {index + 1}
              </span>
              <h3 class="mt-5 text-xl">{step.title}</h3>
              <p class="mt-3 text-[0.9375rem] leading-relaxed text-stone-600">{step.text}</p>
            </li>
          ))
        }
      </ol>

      <!-- The manufacturer's ash analysis -->
      <div data-animate class="mx-auto mt-16 max-w-3xl">
        <h3 class="text-2xl">{t('peat.ash.table.title')}</h3>
        <p class="mt-3 text-[1.0625rem] leading-relaxed text-stone-600">{fill(t('peat.ash.table.lead'))}</p>

        <div class="mt-6 overflow-hidden rounded-3xl border border-stone-200 bg-white shadow-sm">
          <table class="w-full border-collapse text-left">
            <caption class="sr-only">{t('peat.ash.table.title')}</caption>
            <thead class="bg-stone-100">
              <tr>
                <th scope="col" class="px-6 py-3 text-xs font-bold uppercase tracking-wider text-stone-500">
                  {t('specs.table.param')}
                </th>
                <th scope="col" class="px-6 py-3 text-right text-xs font-bold uppercase tracking-wider text-stone-500">
                  {t('specs.table.value')}
                </th>
              </tr>
            </thead>
            <tbody>
              {
                ashRows.map((row) => (
                  <tr class="border-t border-stone-100">
                    <th scope="row" class="px-6 py-3.5 font-medium text-stone-600">
                      {row.label}
                    </th>
                    <td
                      class={`whitespace-nowrap px-6 py-3.5 text-right font-bold ${
                        row.highlight ? 'text-lg text-wood-700' : 'text-stone-900'
                      }`}
                    >
                      {row.value}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <p class="mt-4 text-sm leading-relaxed text-stone-500">{t('peat.ash.table.note')}</p>
      </div>
    </div>
  </section>

  <!-- ==================== FAQ ==================== -->
  <!-- No bottom padding: the closing CTA below opens with its own. -->
  <Faq
    id="peat-faq"
    eyebrow={t('peat.faq.eyebrow')}
    title={t('peat.faq.title')}
    items={faq}
    class="bg-stone-50 pt-24 lg:pt-32"
  />

  <!-- ==================== Closing CTA ==================== -->
  <section class="bg-stone-50 py-20 lg:py-28">
    <div class="mx-auto max-w-4xl px-5 sm:px-8">
      <div
        data-animate
        class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-forest-800 to-forest-950 p-10 text-center shadow-xl shadow-forest-950/20 lg:p-14"
      >
        <span
          class="pointer-events-none absolute -right-20 -top-20 size-56 rounded-full bg-wood-500/20 blur-3xl"
          aria-hidden="true"></span>

        <h2 class="relative text-3xl text-white sm:text-4xl">{t('peat.cta.title')}</h2>
        <p class="relative mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-stone-300">
          {t('peat.cta.text')}
        </p>
        <div class="relative mt-9 flex flex-col justify-center gap-3 sm:flex-row">
          <a
            href={contactHref}
            class="group inline-flex items-center justify-center gap-2 rounded-full bg-wood-600 px-8 py-4 text-base font-bold text-white shadow-lg shadow-wood-950/30 transition-all duration-300 hover:-translate-y-1 hover:scale-[1.03] hover:bg-wood-500 active:translate-y-0"
          >
            {t('peat.hero.ctaPrimary')}
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="size-5 transition-transform duration-300 group-hover:translate-x-1"
              aria-hidden="true"
            >
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          </a>
          {
            whatsappHref !== '' && (
              <a
                href={whatsappHref}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2.5 rounded-full bg-white/10 px-8 py-4 text-base font-bold text-white ring-1 ring-inset ring-white/30 transition-all duration-300 hover:-translate-y-1 hover:bg-white/20 active:translate-y-0"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  class="size-5 text-whatsapp"
                  aria-hidden="true"
                >
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z" />
                </svg>
                {t('peat.hero.ctaWhatsapp')}
              </a>
            )
          }
        </div>
      </div>
    </div>
  </section>
</article>

<script is:inline type="application/ld+json" set:html={JSON.stringify(productSchema)} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
