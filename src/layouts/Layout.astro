---
import '@fontsource-variable/inter';
import '../styles/global.css';

import { getImage } from 'astro:assets';

import {
  getLangFromUrl,
  useTranslations,
  getAlternateLinks,
  localizePath,
  routePath,
  stripLocale,
  findRouteKey,
  type Lang,
} from '../i18n/utils';
import { languageTags, ogLocales, xDefaultLang } from '../i18n/ui';
import { siteConfig } from '../config/site';
import { PRODUCT_IDS } from '../config/pricing';
import {
  buildLocalBusinessSchema,
  buildWebSiteSchema,
  buildWebPageSchema,
  type SchemaProduct,
} from '../config/schema';
import { pelletSpecRows, pelletPackagingRow, ligninSpecRows, peatSpecRows } from '../config/specs';
// The same hashed asset the lignin page shows. There is no photo of the wood
// pellets yet; add one to src/assets/ and pass it below the same way.
import ligninPhoto from '../assets/lignin-pellets.webp';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';

interface Props {
  /** Overrides the default localized <title>. */
  title?: string;
  /** Overrides the default localized meta description. */
  description?: string;
  /**
   * Keeps the page out of the index. Also suppresses the canonical and
   * hreflang tags, which would otherwise advertise URLs that do not exist
   * (as on the 404 page).
   */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const pageTitle = title ?? t('meta.title');
const pageDescription = description ?? t('meta.description');

const origin = Astro.site ?? new URL(Astro.url.origin);

const canonical = new URL(Astro.url.pathname, origin).href;
const alternates = noindex ? [] : getAlternateLinks(Astro.url, Astro.site);

// Which page this is, in any locale: 'home', 'ligninPellets', ... The 404
// page maps to nothing.
const routeKey = noindex ? undefined : findRouteKey(stripLocale(Astro.url.pathname));

// Raster, not SVG: Facebook, LinkedIn and X do not render SVG link previews.
// A page with a photo of its own product previews with that photo, cropped
// to the 1200×630 the networks expect and re-encoded as JPEG, which every
// link-preview fetcher reads (WebP is not universal yet).
interface OgImage {
  url: string;
  width: number;
  height: number;
  type: string;
  alt: string;
}

let og: OgImage = {
  url: new URL('/images/og-image.png', origin).href,
  width: 1200,
  height: 630,
  type: 'image/png',
  alt: t('meta.ogAlt'),
};

if (routeKey === 'ligninPellets') {
  const crop = await getImage({
    src: ligninPhoto,
    width: 1200,
    height: 630,
    fit: 'cover',
    format: 'jpg',
    quality: 82,
  });
  og = {
    url: new URL(crop.src, origin).href,
    width: 1200,
    height: 630,
    type: 'image/jpeg',
    alt: t('lignin.meta.imageAlt'),
  };
}

const ogImage = og.url;

// Every other locale, for og:locale:alternate.
const otherOgLocales = (Object.keys(ogLocales) as Lang[])
  .filter((code) => code !== lang)
  .map((code) => ogLocales[code]);

// Where each product can be enquired about, in the visitor's locale. The two
// pellet diameters live in the landing page's product cards; lignin and peat
// each have a page of their own, with a per-locale slug.
const landingUrl = new URL(localizePath('/', lang), origin).href;
const ligninUrl = new URL(routePath('ligninPellets', lang), origin).href;
const peatUrl = new URL(routePath('peatBriquettes', lang), origin).href;

// Spec rows for `additionalProperty` — the same rows the visible tables show,
// with the diameter first and, for the wood pellets, both packaging formats.
const diameterRow = (value: string) => ({ label: t('specs.row.diameter'), value });
const pelletProperties = (diameter: string) => [
  diameterRow(diameter),
  pelletPackagingRow(t),
  ...pelletSpecRows(t),
];

// The four products, as the landing page shows them. Only the landing page
// carries this catalogue — see `products` in src/config/schema.ts. The lignin
// and peat pages each mark up their own product instead.
const catalogue: SchemaProduct[] = [
  {
    key: 'pellet6mm',
    name: t('specs.d6.title'),
    description: t('specs.d6.desc'),
    url: `${landingUrl}#pellet-6mm`,
    material: t('specs.value.material'),
    properties: pelletProperties('6 mm'),
    enplusCertified: true,
  },
  {
    key: 'pellet8mm',
    name: t('specs.d8.title'),
    description: t('specs.d8.desc'),
    url: `${landingUrl}#pellet-8mm`,
    material: t('specs.value.material'),
    properties: pelletProperties('8 mm'),
    enplusCertified: true,
  },
  {
    key: 'ligninPellets',
    name: t('lignin.hero.title'),
    description: t('lignin.meta.description'),
    url: ligninUrl,
    material: t('lignin.value.origin'),
    // Not ENplus certified — no hasCertification.
    properties: [diameterRow(t('lignin.value.diameter')), ...ligninSpecRows(t)],
    image: new URL(ligninPhoto.src, origin).href,
  },
  {
    key: 'peatBriquettes',
    name: t('peat.hero.title'),
    description: t('peat.meta.description'),
    url: peatUrl,
    material: t('peat.value.material'),
    properties: peatSpecRows(t),
  },
];

// Schema.org LocalBusiness — see src/config/schema.ts. The description is
// the business's, not the page's, so the entity reads the same on every page.
const businessSchema = buildLocalBusinessSchema({
  description: t('meta.description'),
  imageUrl: new URL('/images/og-image.png', origin).href,
  logoUrl: new URL('/favicon.svg', origin).href,
  offerCatalogName: t('specs.eyebrow'),
  products: routeKey === 'home' ? catalogue : [],
});

// What each product page is about. The ids match the Product nodes those
// pages emit, and the BreadcrumbList id the same components give theirs.
const mainEntityId =
  routeKey === 'ligninPellets'
    ? PRODUCT_IDS.ligninPellets
    : routeKey === 'peatBriquettes'
      ? PRODUCT_IDS.peatBriquettes
      : undefined;

const jsonLd = noindex
  ? [businessSchema]
  : [
      businessSchema,
      buildWebSiteSchema(),
      buildWebPageSchema({
        url: canonical,
        name: pageTitle,
        description: pageDescription,
        locale: languageTags[lang],
        imageUrl: ogImage,
        mainEntityId,
        breadcrumbId: mainEntityId !== undefined ? `${canonical}#breadcrumb` : undefined,
      }),
    ];
---

<!doctype html>
<html lang={languageTags[lang]} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    {/* Google Search Console ownership verification */}
    <meta name="google-site-verification" content="Vxg-ROlV1TliHv_OC5o838l4AVfnBvbvkgvtX0h5YjY" />

    {/* Bing Webmaster Tools ownership verification */}
    <meta name="msvalidate.01" content="159F54DC4FAF8AAA39087E88DEB9258F" />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    {noindex && <meta name="robots" content="noindex, follow" />}
    {/* Full-length snippets and large image previews: what AI answers and Discover quote from */}
    {
      !noindex && (
        <meta
          name="robots"
          content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
        />
      )
    }
    {!noindex && <link rel="canonical" href={canonical} />}

    {/*
      favicon.ico for the clients that ask for /favicon.ico directly and do
      not read <link> (Bing, some AI chat citations); sizes="32x32" keeps
      browsers that understand SVG on the SVG. iOS ignores an SVG
      apple-touch-icon, hence the PNG. Both are generated from favicon.svg by
      scripts/make-icons.mjs.
    */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#1c5c41" />

    {/* Locale alternates — omitted on noindex pages */}
    {
      alternates.map((alt) => (
        <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
      ))
    }
    {
      !noindex && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(localizePath(Astro.url.pathname, xDefaultLang), origin).href}
        />
      )
    }

    {/* Open Graph / Twitter */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocales[lang]} />
    {
      !noindex &&
        otherOgLocales.map((code) => <meta property="og:locale:alternate" content={code} />)
    }
    <meta property="og:image" content={og.url} />
    <meta property="og:image:width" content={String(og.width)} />
    <meta property="og:image:height" content={String(og.height)} />
    <meta property="og:image:type" content={og.type} />
    <meta property="og:image:alt" content={og.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={og.url} />
    <meta name="twitter:image:alt" content={og.alt} />

    {
      jsonLd.map((node) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(node)} />
      ))
    }

    {/*
      Marks the document as JS-capable before first paint, so scroll-reveal
      elements are only hidden when we can actually reveal them again.
    */}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body class="min-h-screen bg-stone-50">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-forest-800 focus:px-5 focus:py-3 focus:text-sm focus:font-semibold focus:text-white focus:shadow-xl"
    >
      {t('a11y.skipToContent')}
    </a>

    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />

    {/* Back-to-top button */}
    <button
      type="button"
      id="back-to-top"
      aria-label={t('a11y.backToTop')}
      class="fixed bottom-6 right-6 z-40 grid size-12 translate-y-4 place-items-center rounded-full bg-forest-800 text-white opacity-0 shadow-lg shadow-forest-950/25 transition-all duration-300 hover:scale-110 hover:bg-forest-700 hover:shadow-xl focus-visible:opacity-100 data-[visible]:translate-y-0 data-[visible]:opacity-100"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="size-5"
        aria-hidden="true"
      >
        <path d="m18 15-6-6-6 6"></path>
      </svg>
    </button>

    <script>
      // ---- Scroll reveal -------------------------------------------------
      const animated = document.querySelectorAll<HTMLElement>('[data-animate]');
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (prefersReducedMotion || !('IntersectionObserver' in window)) {
        animated.forEach((el) => el.classList.add('is-visible'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -60px 0px' },
        );

        animated.forEach((el, index) => {
          // Stagger siblings that opt in via data-animate-stagger.
          if (el.dataset.animateStagger !== undefined) {
            el.style.setProperty('--animate-delay', `${(index % 4) * 90}ms`);
          }
          observer.observe(el);
        });
      }

      // ---- Back to top ---------------------------------------------------
      const backToTop = document.getElementById('back-to-top');

      if (backToTop) {
        const toggleBackToTop = () => {
          if (window.scrollY > 600) {
            backToTop.setAttribute('data-visible', '');
          } else {
            backToTop.removeAttribute('data-visible');
          }
        };

        toggleBackToTop();
        window.addEventListener('scroll', toggleBackToTop, { passive: true });

        backToTop.addEventListener('click', () => {
          window.scrollTo({
            top: 0,
            behavior: prefersReducedMotion ? 'auto' : 'smooth',
          });
        });
      }
    </script>

    {/* Cloudflare Web Analytics — last in <body>, per Cloudflare's snippet. */}
    <Analytics />
  </body>
</html>
